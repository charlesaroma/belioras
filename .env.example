# Copy to .env.local. Vite only exposes VITE_ prefixed variables to the client.

# No trailing slash. The /api/<version> prefix is added by apiConfig.js.
VITE_API_BASE_URL=http://localhost:5002
VITE_API_VERSION=v1
VITE_API_TIMEOUT=15000

# Mocks stay on until a service is moved onto HTTP. Setting this to false
# before the backend serves a route breaks every page that reads it.
VITE_API_MOCKS=true
